# Hotel Booking Platform - Environment Variables
# Copy this file to .env and fill in the values as services are added.

NODE_ENV=development

# Database & Cache
DATABASE_URL=postgresql://hotel:hotel_dev_password@localhost:5432/hotel
REDIS_URL=redis://localhost:6379

# Auth & Security (fill with random values in .env)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
INTERNAL_KEY=
PAYMENT_WEBHOOK_SECRET=

# CORS & Ports
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
GATEWAY_PORT=8080
AUTH_SERVICE_PORT=3001
ROOM_SERVICE_PORT=3002
BOOKING_SERVICE_PORT=3003
CHAT_SERVICE_PORT=3004
NOTIFICATION_SERVICE_PORT=3005
